# Blink Shop 环境变量示例。复制为 .env 后按需修改；.env 不得提交。
# 这里的默认值只适合本地开发。APP_ENV=production 时，后端会拒绝默认数据库密码、
# 宽松 CORS、空/默认 AI 密钥和默认对象存储凭证。

# ---------- 运行环境 ----------
# development | test | production
APP_ENV=development
# 启动时自动执行数据库迁移；生产环境应关闭，改为显式迁移。
RUN_MIGRATIONS=true
# 启动时创建/校验 Milvus collection 和索引。
BOOTSTRAP_VECTOR_INDEX=true

# ---------- HTTP ----------
API_ADDR=:8080
# 逗号分隔的允许来源；生产不能为 *。
CORS_ALLOWED_ORIGINS=http://localhost:5173
# JSON 请求体上限（字节）。
HTTP_MAX_BODY_BYTES=1048576
# 上传文件上限（字节）。
UPLOAD_MAX_BYTES=10485760

# ---------- MySQL ----------
MYSQL_DSN=blink:blink_dev_password@tcp(127.0.0.1:3306)/blink_shop?parseTime=true&loc=Local&charset=utf8mb4

# ---------- Redis（可降级，留空则不使用） ----------
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# ---------- Nacos 配置中心（可降级，不可用时使用环境变量/内存默认值） ----------
NACOS_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=
NACOS_GROUP=BLINK_SHOP
NACOS_USERNAME=
NACOS_PASSWORD=

# ---------- 对象存储 MinIO ----------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=blink-shop
MINIO_USE_SSL=false

# ---------- 向量检索 Milvus（可降级，不可用时文本检索退回 MySQL 关键词） ----------
MILVUS_ADDR=127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_TEXT_COLLECTION=blink_shop_text_chunks
MILVUS_IMAGE_COLLECTION=blink_shop_product_images

# ---------- AI 模型（OpenAI 兼容接口；留空则使用规则兜底） ----------
AI_BASE_URL=
AI_API_KEY=
AI_SMALL_MODEL=
AI_LARGE_MODEL=
AI_EMBEDDING_MODEL=
AI_IMAGE_EMBEDDING_MODEL=

# ---------- 语音（留空则对应接口返回 *_not_enabled） ----------
STT_PROVIDER=
STT_APP_ID=
STT_API_KEY=
STT_API_SECRET=
STT_ENDPOINT=
TTS_PROVIDER=
TTS_API_KEY=
TTS_ENDPOINT=
TTS_DEFAULT_VOICE=

# ---------- 本地依赖容器（deployments/docker-compose.yml） ----------
# 使用：docker compose -f deployments/docker-compose.yml --env-file .env up -d
# 修改端口或凭据后，记得同步上面的 MYSQL_DSN / REDIS_ADDR / MINIO_* 等。
BLINK_MYSQL_PORT=3306
BLINK_MYSQL_ROOT_PASSWORD=blink_dev_root
BLINK_MYSQL_DATABASE=blink_shop
BLINK_MYSQL_USER=blink
BLINK_MYSQL_PASSWORD=blink_dev_password
BLINK_REDIS_PORT=6379
BLINK_NACOS_PORT=8848
BLINK_NACOS_GRPC_PORT=9848
BLINK_MINIO_PORT=9000
BLINK_MINIO_CONSOLE_PORT=9001
BLINK_MINIO_ROOT_USER=minioadmin
BLINK_MINIO_ROOT_PASSWORD=minioadmin
BLINK_MILVUS_PORT=19530
