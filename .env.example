# Blink Shop 环境变量示例。复制为 .env 后按需修改；.env 不得提交。
# 这里的默认值只适合本地开发。APP_ENV=production 时，后端启动会拒绝默认数据库密码、
# 宽松 CORS、空/默认 AI 密钥、默认对象存储/Milvus 凭证，并一次列出所有问题。
#
# 读取优先级：环境变量 → 动态配置（Nacos/内存）→ 内置默认值。留空等于未设置。
# 标注“可动态调整”的项：环境变量留空时，可在运行中通过动态配置修改并立即生效；
# 一旦在这里设置，动态配置不会再覆盖它。
# 后端本地启动前加载本文件：set -a && source .env && set +a

# ---------- 运行环境 ----------
# development | test | production（prod 等同 production）
APP_ENV=development
# 启动时自动执行数据库迁移。留空：非生产 true，生产 false。
RUN_MIGRATIONS=
# 启动时创建/校验 Milvus collection 和索引。留空：非生产 true，生产 false。
BOOTSTRAP_VECTOR_INDEX=

# ---------- HTTP（除 API_ADDR 外均可动态调整） ----------
API_ADDR=:8080
# 逗号分隔的允许来源；内置默认 *，生产必须是明确域名列表。
CORS_ALLOWED_ORIGINS=http://localhost:5173
# 可信反向代理（逗号分隔的 CIDR 或 IP）。只有直连方在此列表中时才采信 X-Forwarded-For。
TRUSTED_PROXY_CIDRS=
# 信任所有代理头，仅限本地调试；生产禁止开启。
TRUST_ALL_PROXIES=false
# JSON 请求体上限（字节），默认 1 MiB。
HTTP_MAX_BODY_BYTES=1048576
# 单个上传文件上限（字节），默认 10 MiB；multipart 请求体另留 64 KiB 余量。
UPLOAD_MAX_BYTES=10485760
# POST /files 允许的文件类型（按内容嗅探），只能从 image/jpeg、image/png、image/webp、image/gif、image/bmp、application/pdf 中选。
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf
# 非流式请求超时（Go duration，如 30s）；SSE 和实时语音不受此限制。
HTTP_REQUEST_TIMEOUT=30s
# 认证前按客户端 IP、认证后按账号的每分钟请求上限。
RATE_LIMIT_IP_PER_MINUTE=120
RATE_LIMIT_ACCOUNT_PER_MINUTE=120

# ---------- 认证（可动态调整） ----------
# 登录 token 有效期（Go duration）。
AUTH_TOKEN_TTL=24h
# 同一用户名每分钟最多尝试登录次数。
LOGIN_ATTEMPTS_PER_MINUTE=10
# 头像文件目录（仅启动时读取，相对后端启动目录）。
AVATAR_UPLOAD_DIR=uploads/avatar

# ---------- MySQL ----------
# 含 & 的值必须加引号，否则 shell source 时会出错。
MYSQL_DSN='blink:blink_dev_password@tcp(127.0.0.1:3306)/blink_shop?parseTime=true&loc=Local&charset=utf8mb4'

# ---------- Redis（可降级，留空则不使用） ----------
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# ---------- Nacos 配置中心（可降级，不可用时使用环境变量/内存默认值） ----------
NACOS_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=
NACOS_GROUP=BLINK_SHOP
NACOS_USERNAME=
NACOS_PASSWORD=

# ---------- 对象存储 MinIO ----------
# 私有文件上传；留空表示未配置，文件接口返回 503 object_storage_unavailable，其他功能照常。
# 地址不带协议；桶不存在时首次上传自动创建。
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=blink-shop
MINIO_USE_SSL=false

# ---------- 向量检索（可选：MILVUS_ADDR 和 EMBEDDING_API_KEY 都填了才启用，否则知识和商品只用关键词检索） ----------
# DeepSeek 没有 Embedding 接口，需要另找 OpenAI 兼容的 /embeddings 服务（默认 DashScope text-embedding-v3，1024 维）。
# 换模型或维度后用 `go run ./cmd/vectorindex -recreate` 重建集合。
MILVUS_ADDR=
MILVUS_TOKEN=
MILVUS_TEXT_COLLECTION=blink_shop_text_chunks
MILVUS_PRODUCT_COLLECTION=blink_shop_products
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIM=

# 图片搜索：配置了 MILVUS_ADDR 就启用。默认 local（本地颜色 + 边缘特征，不调外部服务）；dashscope 需要密钥。
# 商品图只读平台内图片，https 图片只从白名单域名下载（逗号分隔，只写主机名）。
MILVUS_IMAGE_COLLECTION=blink_shop_product_images
IMAGE_EMBEDDING_PROVIDER=local
IMAGE_EMBEDDING_API_KEY=
IMAGE_EMBEDDING_BASE_URL=
IMAGE_EMBEDDING_MODEL=
IMAGE_EMBEDDING_DIM=
IMAGE_FETCH_ALLOWED_HOSTS=

# ---------- AI 模型（OpenAI 兼容接口；留空则使用规则兜底） ----------
# 默认 DeepSeek：只填 AI_API_KEY 即可；其余留空用默认值（https://api.deepseek.com/v1、deepseek-chat）
AI_API_KEY=
AI_BASE_URL=
AI_PLANNER_MODEL=
AI_AGENT_MODEL=

# ---------- 语音（off 则对应接口返回 *_not_enabled；凭据只在服务端，客户端经 /speech/* 代理） ----------
# 识别：off / mock（演示，不调外部服务，生产不允许）/ xunfei（讯飞实时转写，三项凭据都要）
STT_PROVIDER=off
STT_APP_ID=
STT_API_KEY=
STT_API_SECRET=
STT_ENDPOINT=
STT_LANG=
STT_MAX_SECONDS=
# 合成：off / mock / xunfei（appid + key + secret）/ doubao（appid + token 填 TTS_API_KEY）；地址和音色为空用供应商默认
TTS_PROVIDER=off
TTS_APP_ID=
TTS_API_KEY=
TTS_API_SECRET=
TTS_ENDPOINT=
TTS_DEFAULT_VOICE=
TTS_CLUSTER=
TTS_MAX_RUNES=

# ---------- 本地依赖容器（deployments/docker-compose.yml） ----------
# 使用：docker compose -f deployments/docker-compose.yml --env-file .env up -d
# 修改端口或凭据后，记得同步上面的 MYSQL_DSN / REDIS_ADDR / MINIO_* 等。
BLINK_MYSQL_PORT=3306
BLINK_MYSQL_ROOT_PASSWORD=blink_dev_root
BLINK_MYSQL_DATABASE=blink_shop
BLINK_MYSQL_USER=blink
BLINK_MYSQL_PASSWORD=blink_dev_password
BLINK_REDIS_PORT=6379
BLINK_NACOS_PORT=8848
BLINK_NACOS_GRPC_PORT=9848
BLINK_MINIO_PORT=9000
BLINK_MINIO_CONSOLE_PORT=9001
BLINK_MINIO_ROOT_USER=minioadmin
BLINK_MINIO_ROOT_PASSWORD=minioadmin
BLINK_MILVUS_PORT=19530
