<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout style="@style/TopBar">

        <TextView
            android:id="@+id/back_button"
            style="@style/TopBarButton"
            android:contentDescription="@string/back"
            android:text="‹"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/top_title"
            style="@style/TopBarTitle"
            android:accessibilityHeading="true"
            android:text="@string/login" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/page_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tab_login"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/login"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tab_register"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/register"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout style="@style/Card">

                <TextView
                    android:id="@+id/username_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/username"
                    android:text="账号"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/username"
                    style="@style/Field"
                    android:autofillHints="username"
                    android:hint="账号"
                    android:inputType="text"
                    android:maxLength="32"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/username_rule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="3–32 位字母、数字、下划线或短横线"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:labelFor="@+id/password"
                    android:text="密码"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/password"
                    style="@style/Field"
                    android:autofillHints="password"
                    android:hint="密码"
                    android:inputType="textPassword"
                    android:maxLength="64"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/password_rule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="8–64 个字符"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/display_name_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:labelFor="@+id/display_name"
                        android:text="昵称（选填）"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/display_name"
                        style="@style/Field"
                        android:autofillHints="nickname"
                        android:hint="不填则使用账号"
                        android:inputType="textPersonName"
                        android:maxLength="32"
                        android:maxLines="1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/form_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/danger"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/submit"
                    style="@style/PrimaryButton"
                    android:layout_marginTop="16dp"
                    android:text="@string/login" />
            </LinearLayout>

            <TextView
                android:id="@+id/api_settings"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
