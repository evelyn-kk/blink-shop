<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout style="@style/TopBar">

            <TextView
                android:id="@+id/back_button"
                style="@style/TopBarButton"
                android:contentDescription="@string/back"
                android:text="‹"
                android:textSize="26sp" />

            <TextView
                style="@style/TopBarTitle"
                android:accessibilityHeading="true"
                android:text="评价商品" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    style="@style/Card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/review_image"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_image"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:id="@+id/review_product"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout style="@style/Card">

                    <TextView
                        style="@style/SectionTitle"
                        android:accessibilityHeading="true"
                        android:text="评分" />

                    <LinearLayout
                        android:id="@+id/star_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                    <TextView
                        android:id="@+id/rating_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:labelFor="@+id/review_content"
                        android:text="评价内容"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/review_content"
                        style="@style/Field"
                        android:gravity="top|start"
                        android:hint="说说商品怎么样（最多 500 字）"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="500"
                        android:minLines="4"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp" />

                    <TextView
                        android:id="@+id/content_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:labelFor="@+id/review_tags"
                        android:text="标签（选填，最多 5 个）"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/review_tags"
                        style="@style/Field"
                        android:hint="用空格或逗号分隔，如：音质好 续航长"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/review_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:accessibilityLiveRegion="polite"
                        android:textColor="@color/danger"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="评价提交后会公开显示在商品页。未提交的内容会自动保存为草稿。"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            style="@style/BottomBar"
            android:gravity="end|center_vertical">

            <Button
                android:id="@+id/review_submit"
                style="@style/BottomBarButton"
                android:text="提交评价" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/view_busy" />
</FrameLayout>
