<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout style="@style/TopBar">

            <TextView
                android:id="@+id/back_button"
                style="@style/TopBarButton"
                android:contentDescription="@string/back"
                android:text="‹"
                android:textSize="26sp" />

            <TextView
                style="@style/TopBarTitle"
                android:accessibilityHeading="true"
                android:text="支付订单" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/pay_result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:accessibilityLiveRegion="polite"
                        android:padding="12dp"
                        android:textSize="15sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/orders_card"
                        style="@style/Card" />

                    <LinearLayout
                        android:id="@+id/method_card"
                        style="@style/Card">

                        <TextView
                            style="@style/SectionTitle"
                            android:accessibilityHeading="true"
                            android:text="支付方式（演示环境为模拟支付）" />

                        <RadioGroup
                            android:id="@+id/method_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <RadioButton
                                android:id="@+id/method_alipay"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/touch_target"
                                android:checked="true"
                                android:text="支付宝（模拟）" />

                            <RadioButton
                                android:id="@+id/method_wechat"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/touch_target"
                                android:text="微信支付（模拟）" />

                            <RadioButton
                                android:id="@+id/method_balance"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/touch_target"
                                android:text="余额（模拟）" />
                        </RadioGroup>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/done_actions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <Button
                            android:id="@+id/view_orders"
                            style="@style/SecondaryButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="查看订单" />

                        <View
                            android:layout_width="12dp"
                            android:layout_height="1dp" />

                        <Button
                            android:id="@+id/keep_shopping"
                            style="@style/SecondaryButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="继续逛逛" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <include layout="@layout/view_state" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/bottom_bar"
            style="@style/BottomBar">

            <TextView
                android:id="@+id/pay_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/price"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/pay_button"
                style="@style/BottomBarButton"
                android:text="确认支付" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/view_busy" />
</FrameLayout>
