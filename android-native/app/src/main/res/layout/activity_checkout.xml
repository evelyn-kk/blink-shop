<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout style="@style/TopBar">

            <TextView
                android:id="@+id/back_button"
                style="@style/TopBarButton"
                android:contentDescription="@string/back"
                android:text="‹"
                android:textSize="26sp" />

            <TextView
                style="@style/TopBarTitle"
                android:accessibilityHeading="true"
                android:text="确认订单" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/pending_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_warning"
                        android:padding="12dp"
                        android:text="上次提交的订单没有收到结果。再次提交不会重复下单：如果上次已经成功，会直接显示那次的订单。"
                        android:textColor="@color/warning_text"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/items_card"
                        style="@style/Card" />

                    <LinearLayout
                        android:id="@+id/coupon_row"
                        style="@style/Card"
                        android:background="@drawable/bg_card"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:minHeight="56dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="优惠券"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/coupon_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textColor="@color/brand"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/discount_card"
                        style="@style/Card" />
                </LinearLayout>
            </ScrollView>

            <include layout="@layout/view_state" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/bottom_bar"
            style="@style/BottomBar">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/pay_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/price"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pay_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/submit_button"
                style="@style/BottomBarButton"
                android:text="提交订单" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/view_busy" />
</FrameLayout>
