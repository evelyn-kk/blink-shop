    {
      "description": "检索知识库（商品说明、售后政策、使用指南），返回可引用的分块；回答只能引用返回的片段。",
      "intents": [
        "guide",
        "knowledge",
        "product_compare",
        "product_search"
      ],
      "name": "search_knowledge",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "default": 3,
            "description": "返回数量",
            "maximum": 20,
            "minimum": 1,
            "type": "integer"
          },
          "product_id": {
            "description": "只看某个商品的资料",
            "type": "string"
          },
          "query": {
            "description": "要查证的问题",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "private": [],
      "write": false
    },
    {
      "description": "搜索当前商品库：按关键词召回，按预算和排除词过滤，再按相关性排序。只有 relevance=ok 的结果能当作推荐。",
      "intents": [
        "cart",
        "guide",
        "knowledge",
        "product_compare",
        "product_search",
        "review"
      ],
      "name": "search_products",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "category_id": {
            "description": "限定分类 ID（含子分类）",
            "type": "string"
          },
          "exclude": {
            "description": "排除词：名称、品牌、标签或卖点包含任一词的商品不返回",
            "items": {
              "maxLength": 30,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 10,
            "type": "array"
          },
          "limit": {
            "default": 5,
            "description": "返回数量",
            "maximum": 20,
            "minimum": 1,
            "type": "integer"
          },
          "max_price": {
            "description": "价格上限（元）",
            "minimum": 0,
            "type": "number"
          },
          "product_id": {
            "description": "直接按商品 ID 取一件商品（用户明确指定时）",
            "type": "string"
          },
          "query": {
            "description": "商品关键词（品类、品牌、型号、用途）",
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "private": [],
      "write": false
