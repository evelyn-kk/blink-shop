{
  "description": "用本人上传的图片找相似的在售商品：status 为 matched（最像的达到同款阈值）/ similar（只有外观相近的）/ no_match；每件带相似度、等级（match / similar）和最像的那张商品图。只返回在售商品。score 允许 ±0.001（不同 CPU 的浮点运算末位可能不同）",
  "setup": {
    "as": "blink_user",
    "multipart": {
      "field": "file",
      "filename": "photo.png",
      "content_base64": ""
    }
  },
  "request": {
    "method": "POST",
    "path": "/api/v1/search/image",
    "as": "blink_user",
    "body": {
      "file_id": "{setup_file_id}",
      "top_k": 3
    }
  },
  "response": {
    "status": 200,
    "body": {
      "status": "matched",
      "embedder": "local:color-edge-v1:160",
      "items": [
        {
          "product": {
            "product_id": "p_seed_lamp",
            "sku_id": "sku_seed_lamp_white",
            "merchant_id": "m_seed_home",
            "merchant_name": "Blink 家居生活馆",
            "category_id": "c_lamp",
            "name": "Blink 护眼台灯 L1",
            "brand": "Blink Home",
            "image_url": "/api/v1/assets/catalog/products/p_seed_lamp.png",
            "price": "249.00",
            "market_price": "299.00",
            "stock_status": "in_stock",
            "tags": [
              "护眼",
              "学习"
            ],
            "selling_points": [
              "无频闪",
              "色温可调"
            ],
            "recommend_reason": "无频闪、可调色温。",
            "risk_notes": []
          },
          "score": 0.8875,
          "level": "match",
          "matched_image_url": "/api/v1/assets/catalog/products/p_seed_lamp.png"
        }
      ]
    }
  }
}
