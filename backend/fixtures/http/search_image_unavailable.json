{
  "description": "没有配置图片搜索（未配置 Milvus）：503 image_search_unavailable，客户端提示改用文字描述",
  "setup": {
    "as": "blink_user",
    "multipart": {
      "field": "file",
      "filename": "photo.png",
      "content_base64": ""
    }
  },
  "request": {
    "method": "POST",
    "path": "/api/v1/search/image",
    "as": "blink_user",
    "image_search": "unavailable",
    "body": {
      "file_id": "{setup_file_id}"
    }
  },
  "response": {
    "status": 503,
    "body": {
      "code": "image_search_unavailable",
      "message": "图片搜索暂不可用，请稍后再试或用文字描述商品",
      "request_id": "<request_id>"
    }
  }
}
