{
  "description": "用 PDF 等非图片文件搜索：400 unsupported_file_type",
  "setup": {
    "as": "blink_user",
    "multipart": {
      "field": "file",
      "filename": "a.pdf",
      "content_base64": "JVBERi0xLjQKJeLjz9MKMSAwIG9iajw8Pj5lbmRvYmoKdHJhaWxlcjw8Pj4KJSVFT0YK"
    }
  },
  "request": {
    "method": "POST",
    "path": "/api/v1/search/image",
    "as": "blink_user",
    "body": {
      "file_id": "{setup_file_id}"
    }
  },
  "response": {
    "status": 400,
    "body": {
      "code": "unsupported_file_type",
      "message": "只能用图片搜索",
      "field": "file_id",
      "request_id": "<request_id>"
    }
  }
}
