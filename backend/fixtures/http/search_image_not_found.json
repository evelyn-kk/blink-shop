{
  "description": "用别人上传的文件搜索：和文件不存在一样返回 404，不暴露文件是否存在",
  "setup": {
    "as": "blink_user",
    "multipart": {
      "field": "file",
      "filename": "photo.png",
      "content_base64": ""
    }
  },
  "request": {
    "method": "POST",
    "path": "/api/v1/search/image",
    "as": "blink_user2",
    "body": {
      "file_id": "{setup_file_id}"
    }
  },
  "response": {
    "status": 404,
    "body": {
      "code": "file_not_found",
      "message": "文件不存在",
      "request_id": "<request_id>"
    }
  }
}
