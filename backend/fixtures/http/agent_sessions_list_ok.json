          "message_count": 1,
          "last_message_at": "<timestamp>",
          "pinned": false,
          "pinned_at": null,
          "created_at": "<timestamp>",
          "updated_at": "<timestamp>"
        }
      ],
      "page": 1,
      "page_size": 10,
      "total": 1
    }
  }
}
