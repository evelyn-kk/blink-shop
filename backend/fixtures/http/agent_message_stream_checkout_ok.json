                  "status": "pending",
                  "transaction_no": ""
                },
                "payment_deadline_at": "<timestamp>",
                "shipped_at": null,
                "status": "pending_payment",
                "total_amount": "599.00",
                "updated_at": "<timestamp>"
              }
            ],
            "type": "order_list"
          }
        }
      },
      {
        "event": "block",
        "data": {
          "block": {
            "action": "navigate",
            "label": "去我的订单",
            "params": {},
            "target": "orders",
            "type": "action"
          }
        }
      },
      {
        "event": "followups",
        "data": {
          "questions": [
            "支付订单",
            "我的订单",
