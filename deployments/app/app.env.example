# 应用层部署的配置模板：复制为 app.env（不提交）后填写。验收用 quality/acceptance/setup.sh 自动生成。
APP_ENV=production
# 只读这台库：专用账号、强密码；迁移由 /migrate 在发布时执行
MYSQL_DSN=blink_app:<强密码>@tcp(mysql:3306)/blink_shop?parseTime=true&charset=utf8mb4
RUN_MIGRATIONS=false
BOOTSTRAP_VECTOR_INDEX=false
CORS_ALLOWED_ORIGINS=https://shop.example.com
# 反向代理（nginx）所在网段，用来识别真实客户端 IP
TRUSTED_PROXY_CIDRS=172.16.0.0/12
SHUTDOWN_DRAIN=5s
METRICS_TOKEN=<至少 24 个字符>
MYSQL_MAX_OPEN_CONNS=50
MYSQL_MAX_IDLE_CONNS=25

MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=blink-shop
MINIO_ACCESS_KEY=<专用账号>
MINIO_SECRET_KEY=<强密码>

# 可选：图片搜索（本地特征，不调外部服务）；生产 Milvus 必须开鉴权
MILVUS_ADDR=milvus:19530
MILVUS_TOKEN=<用户名:密码>
MILVUS_IMAGE_COLLECTION=blink_shop_product_images

# 可选：模型和文本向量（为空时导购走规则、检索用关键词）
AI_API_KEY=
EMBEDDING_API_KEY=
